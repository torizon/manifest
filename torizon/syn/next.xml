<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <remote alias="repo" fetch="https://github.com/synaptics-astra" name="synaptics"/>
  <remote alias="repo" fetch="https://github.com/uptane" name="uptane"/>
  <remote alias="repo" fetch="https://github.com/torizon" name="torizon"/>
  <remote alias="repo" fetch="https://git.yoctoproject.org" name="yp"/>
  <remote alias="repo" fetch="https://github.com/meta-qt5" name="qt"/>
  <remote alias="repo" fetch="https://github.com/OSSystems" name="ossystems"/>
  <remote alias="repo" fetch="https://github.com/kraj" name="kraj"/>
  <remote alias="repo" fetch="https://github.com/openembedded" name="oe"/>
  <remote alias="repo" fetch="https://github.com/sbabic" name="swupdate"/>

  <default sync-j="4" sync-s="true"/>

  <!-- BROKEN: synaptics has no "master"-equivalent branch yet (newest published is scarthgap_6.12_v2.5.0, no wrynose line); build will fail until they cut one.
       TODO: check for a newer branch (e.g. a wrynose_* line) and bump this to it once published. -->
  <project name="meta-synaptics" path="layers/meta-synaptics" remote="synaptics" revision="scarthgap_6.12_v2.5.0" upstream="scarthgap_6.12_v2.5.0"/>

  <project name="meta-browser" path="layers/meta-browser" remote="ossystems" revision="wrynose" upstream="wrynose"/>
  <project name="meta-clang" path="layers/meta-clang" remote="kraj" revision="wrynose" upstream="wrynose"/>
  <project name="meta-swupdate" path="layers/meta-swupdate" remote="swupdate" revision="wrynose" upstream="wrynose"/>

  <project name="meta-openembedded" path="layers/meta-openembedded" remote="oe" revision="wrynose" upstream="wrynose"/>
  <project name="openembedded-core" remote="oe" path="layers/oe-core" revision="wrynose" upstream="wrynose"/>
  <project name="bitbake" path="layers/oe-core/bitbake" remote="oe" revision="2.18" upstream="2.18"/>

  <project name="meta-yocto" remote="yp" path="layers/meta-yocto" revision="wrynose" upstream="wrynose"/>
  <project name="meta-selinux" path="layers/meta-selinux" remote="yp" revision="wrynose" upstream="wrynose"/>
  <project name="meta-security" remote="yp" path="layers/meta-security" revision="wrynose" upstream="wrynose"/>
  <project name="meta-lts-mixins" path="layers/meta-lts-mixins" remote="yp" revision="wrynose/rust" upstream="wrynose/rust"/>
  <project name="meta-virtualization" path="layers/meta-virtualization" remote="yp" revision="wrynose" upstream="wrynose"/>

  <project name="meta-qt5" path="layers/meta-qt5" remote="qt" revision="wrynose" upstream="wrynose" />

  <project name="meta-updater" path="layers/meta-updater" remote="uptane" revision="wrynose" upstream="wrynose"/>
  <project name="meta-torizon" path="layers/meta-torizon" remote="torizon" revision="wrynose-8.x.y" upstream="wrynose-8.x.y"/>
  <project name="meta-torizon-bsp" path="layers/meta-torizon-bsp" remote="torizon" revision="wrynose-8.x.y" upstream="wrynose-8.x.y">
    <linkfile dest="setup-environment" src="scripts/setup-environment"/>
  </project>
</manifest>
